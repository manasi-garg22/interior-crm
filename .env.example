# ─────────────────────────────────────────────────────────────
#  Interior CRM — environment template
#  Copy to .env and fill in. NEVER commit a real .env.
#  Every value here is parsed by packages/config/src/env.ts at
#  boot; a missing or malformed value fails fast with a clear
#  message rather than at 2am during a campaign.
# ─────────────────────────────────────────────────────────────

# ── core ──────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/interior_crm?schema=public
# Only needed on pooled hosts (Neon/Supabase) where migrations need a direct link.
DIRECT_DATABASE_URL=

# ── auth ──────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=28800

# ── storage (S3-compatible) ───────────────────────────────────
# local  = writes to ./.storage, no credentials needed (dev default)
# s3     = AWS S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=15

# ── whatsapp ──────────────────────────────────────────────────
# mock = logs messages, never calls out. The CRM is fully usable on mock.
WHATSAPP_DRIVER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── meta / instagram lead ads ─────────────────────────────────
META_DRIVER=mock
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── email ─────────────────────────────────────────────────────
# console = prints the email to stdout (dev default)
EMAIL_DRIVER=console
EMAIL_API_KEY=
EMAIL_FROM="Interior Studio <noreply@example.com>"
SALES_NOTIFICATION_EMAIL=

# ── spam protection / rate limiting ───────────────────────────
# Leave the Turnstile keys blank in dev and the check is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_DRIVER=memory
PUBLIC_FORM_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15MIN=5

# ── business ──────────────────────────────────────────────────
COMPANY_NAME="Interior Studio"
COMPANY_PHONE=+911234567890
COMPANY_WHATSAPP=+911234567890
DEFAULT_COUNTRY=IN
LEAD_ASSIGNMENT_STRATEGY=round_robin

# ── seed (development only) ───────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
